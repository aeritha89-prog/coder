CODER_MODEL=qwen3.5:4b
CODER_API_KEY=
CODER_BASE_URL=http://127.0.0.1:11434/v1
CODER_WORKSPACE=.
CODER_MAX_ROUNDS=12
CODER_COMMAND_TIMEOUT_S=60
CODER_MAX_TOOL_OUTPUT_CHARS=12000
# 技能完整正文有独立预算，超限明确拒绝激活，不截断正文
CODER_MAX_SKILL_CHARS=40000
CODER_MAX_ACTIVE_SKILL_CHARS=60000
CODER_CONTEXT_WINDOW_TOKENS=32000
CODER_REQUEST_TIMEOUT_S=60
# 项目长期记忆：语义 / 情景 / 程序性；短期摘要随会话保存
CODER_MEMORY_ENABLED=true
CODER_MEMORY_MAX_CONTEXT_TOKENS=1200
CODER_MEMORY_TOP_K=6
# 常驻资料先使用此预算和条目上限；计入上面的总预算，剩余额度用于按需检索
CODER_MEMORY_ALWAYS_MAX_CONTEXT_TOKENS=256
CODER_MEMORY_ALWAYS_MAX_ENTRIES=8
CODER_MEMORY_MAX_ENTRIES=1000
# 自动归档真实工具观察；语义和程序性知识通过 memory_remember 写入
CODER_MEMORY_AUTO_EPISODE=true
# 首次启动需要先运行 coder sandbox build 和 sandbox doctor
# CODER_SANDBOX_PROFILE=general
# CODER_SANDBOX_NETWORK=none
# 选择 allowlist 时必须填写域名，例如 pypi.org,files.pythonhosted.org,*.npmjs.org
# CODER_SANDBOX_NETWORK_ALLOWLIST=
# CODER_SANDBOX_TRUST_FAKE_IP_DNS=false
# 每个任务的代理收发总流量上限
# CODER_SANDBOX_NETWORK_MAX_BYTES=536870912
# CODER_SANDBOX_CPUS=2
# CODER_SANDBOX_MEMORY_MB=4096
# CODER_SANDBOX_PIDS_LIMIT=128
# CODER_SANDBOX_MAX_COMMAND_TIMEOUT_S=1800
# CODER_SANDBOX_COMMAND_OUTPUT_BYTES=1048576
# 有限时长命令可在后台执行；运行期间仍可编辑和执行前台命令
CODER_SANDBOX_BACKGROUND_ENABLED=true
CODER_SANDBOX_MAX_BACKGROUND_JOBS=4
# 工作区逻辑容量监测，不是 Docker volume 的硬磁盘配额
# CODER_SANDBOX_WORKSPACE_MAX_BYTES=1073741824
# CODER_SANDBOX_WORKSPACE_MAX_FILES=50000
# Sandbox 默认不注册宿主 web_search；启用后查询会发送至 Tavily
# CODER_SANDBOX_ALLOW_WEB_SEARCH=false
# 可选预览端口白名单；仅绑定宿主 127.0.0.1，例如 3000,5173
# CODER_SANDBOX_SERVICE_PORTS=3000,5173
# CODER_SANDBOX_APPLY=review
# CODER_SANDBOX_STATE_DIR=~/.coder/sandbox
